# Read by ~/.local/bin/{land,agent-status}. Shell syntax, one value per line.
BASE=dev
GATE='just ci'
# AGENTS.md "Full gate": both `just ci` and `just qa` before every PR.
GATE_EXTRA='just qa'
PR_REF=Closes
# Public repo: wait for CodeRabbit (land checks its review and unresolved threads).
REVIEW=coderabbit
# Globs (matched with [[ == ]], so * crosses /) that also need an owner approval or a second review:
# the manifest and permissions (wxt.config.ts) and the persisted-data shapes and their versions (AGENTS.md hard rule).
REVIEW_STRICT_PATHS='wxt.config.ts src/settings/schema.ts src/settings/migrate.ts src/shared/sync.ts src/backup/snapshot.ts'
SETUP='npm ci'
CLAIM_LABELS=0
MIGRATIONS=''
