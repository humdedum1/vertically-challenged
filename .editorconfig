root = true

# Matches biome.json: 2-space indent, 100-column lines.
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 100

# Markdown uses two trailing spaces for hard line breaks.
[*.md]
trim_trailing_whitespace = false
max_line_length = off
