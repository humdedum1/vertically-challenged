{
  "name": "vertically-challenged",
  "description": "Fast, customizable vertical tabs in Chrome's side panel. Local-first.",
  "private": true,
  "version": "1.7.1",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "pack:crx": "npm run build && node scripts/pack-crx.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node tests/e2e/run-all.mjs",
    "bench:pure": "vitest run --config bench/vitest.config.ts",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@tsconfig/svelte": "^5.0.8",
    "@wxt-dev/module-svelte": "^2.0.5",
    "playwright-core": "^1.64.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "~7.0.2",
    "vitest": "^5.0.5",
    "wxt": "^0.21.4"
  }
}
